__pycache__/
*.pyc
.venv/
venv/
.env
*.egg-info/
.DS_Store
.pytest_cache/

# Module 1 build artifacts are regenerated by `python -m data_pipeline.build_dataset`
# from the raw CSV + confusability_audit.json -- no need to track them.
data/processed/*.jsonl
data/processed/*.json
data/processed/*.md
!data/processed/.gitkeep

# Module 2 (finetuning) adapter checkpoints are binary artifacts regenerated by
# a Colab run of finetuning/train.py (see finetuning/colab_runbook.md) -- not source.
# finetuning/reports/*.md|*.json are NOT ignored: unlike Module 1's build_report
# (a deterministic recomputation of the same CSV), these record the outcome of an
# actual GPU training run that isn't guaranteed bit-for-bit reproducible, so they're
# kept as real evidence of what was run rather than treated as disposable.
finetuning/checkpoints/*
!finetuning/checkpoints/.gitkeep
!finetuning/checkpoints/README.md


docs/*

CLAUDE.md
plan.md 
# Module 5 (app/backend) job history is runtime state, not source -- regenerated by
# whatever erasure requests actually get submitted during a live demo.
app/backend/jobs/*.json
